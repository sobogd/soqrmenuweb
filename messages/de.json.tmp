  "changelog": {
    "meta": {
      "title": "Neuerungen – IQ Rest Updates & Neue Funktionen",
      "description": "Bleiben Sie auf dem Laufenden über die neuesten Funktionen und Verbesserungen von IQ Rest – Ihrer digitalen QR-Speisekartenlösung für Restaurants und Cafés."
    },
    "title": "Neuerungen",
    "subtitle": "Neueste Updates und neue Funktionen für Ihre Restaurant-QR-Speisekarte",
    "readMore": "Mehr erfahren",
    "backToChangelog": "Zurück zum Changelog",
    "seo": {
      "title": "IQ Rest Updates & Neuigkeiten",
      "description": "IQ Rest wird ständig verbessert, um Restaurants und Cafés bei der Erstellung professioneller digitaler QR-Speisekarten zu unterstützen. Verfolgen Sie unser Changelog, um über die neuesten Funktionen für Ihre Restaurant-Website und QR-Speisekarten-Lösung auf dem Laufenden zu bleiben."
    },
    "entries": {
      "dashboard-ui-redesign-consistent-cards-navigation": {
        "title": "Dashboard UI Redesign: Consistent Cards, Navigation & Form Actions",
        "description": "A polished dashboard with unified card styling, persistent sidebar navigation, accent-colored active states, and bottom save/delete actions on every form page.",
        "meta": {
          "title": "Dashboard UI Redesign: Cards, Navigation & Forms | IQ Rest",
          "description": "IQ Rest dashboard redesigned with consistent card components, persistent sidebar navigation with active page highlighting, and improved form actions. Manage your restaurant QR menu with a cleaner, more intuitive interface."
        },
        "content": {
          "intro": "IQ Rest has undergone a comprehensive dashboard UI redesign. Every page now uses consistent card styling with unified border radii, a persistent sidebar navigation with accent-colored active states, and improved form pages with bottom save and delete actions. The result is a cleaner, more polished experience for managing your restaurant's digital QR menu.",
          "image1Alt": "Redesigned dashboard with consistent card styling",
          "image1Caption": "Unified card components across all dashboard pages",
          "section1Title": "Consistent Card Design Across All Pages",
          "section1Text": "Every dashboard page now uses a unified DashboardCard component with consistent rounded borders, subtle background colors, and optional section headers. Analytics, billing, settings, contacts, reservation settings, and all form pages share the same visual language. Hint labels with popover tooltips replace inline description text, keeping the interface clean while still providing helpful context when needed.",
          "section2Title": "Persistent Sidebar Navigation with Active States",
          "section2Text": "On desktop screens, a persistent sidebar navigation is now visible on every page. The active page is highlighted with an accent color background, making it immediately clear where you are. Sub-pages like categories, items, and orders correctly highlight the parent Menu item. The sidebar includes quick access to Menu, Print QR, Reservations, Analytics, Settings, Contacts, Billing, and Support — all without leaving the current view.",
          "section3Title": "Improved Form Pages with Bottom Actions",
          "section3Text": "All form pages — categories, items, tables, design, settings, contacts, and reservation settings — now feature a duplicate save button at the bottom in accent color. Delete buttons appear on the left side with a muted style. This means you no longer need to scroll back to the top to save your changes. The logout button has been moved from the sidebar to the bottom of the design page, keeping the navigation focused on essential actions.",
          "benefitsTitle": "Benefits of the UI Redesign",
          "benefit1": "Unified card styling with consistent borders and backgrounds across all pages",
          "benefit2": "Persistent sidebar navigation on desktop with accent-colored active states",
          "benefit3": "Bottom save buttons on all forms — no need to scroll up to save",
          "benefit4": "Delete and save actions clearly separated — delete left, save right",
          "benefit5": "Section headers on form cards for better visual organization",
          "benefit6": "Cleaner analytics page with DashboardCard wrappers and improved device stats layout",
          "conclusionTitle": "A More Polished Dashboard Experience",
          "conclusionText": "This UI redesign brings visual consistency and improved usability to every corner of the IQ Rest dashboard. Whether you're editing menu items, checking analytics, or managing reservations, the interface feels cohesive and intuitive. Combined with the persistent sidebar navigation, managing your restaurant's digital QR menu is faster and more enjoyable than ever.",
          "ctaText": "Experience the redesigned dashboard",
          "ctaButton": "Open Dashboard"
        }
      },
      "ai-menu-scanner-create-digital-qr-menu": {
        "title": "AI Menu Scanner: Create Digital QR Menu from a Photo",
        "description": "Upload a photo of your paper menu and AI creates a complete digital QR menu for your restaurant instantly. Extract dishes, generate backgrounds, and go live in minutes.",
        "meta": {
          "title": "AI Menu Scanner - Create Digital QR Menu from Photo | IQ Rest",
          "description": "Upload a photo of your paper menu and AI instantly creates a digital QR menu for your restaurant. Automatic dish extraction, AI background generation, and instant preview. The fastest way to create a QR menu."
        },
        "content": {
          "intro": "IQ Rest introduces the AI Menu Scanner — the fastest way to create a digital QR menu for your restaurant. Simply take a photo of your existing paper menu, and our AI technology extracts all dishes with names, descriptions, and prices. It even generates a professional background image for your restaurant website. What used to take hours of manual data entry now takes just minutes.",
          "image1Alt": "AI menu scanner creating digital QR menu from photo",
          "image1Caption": "Upload a photo of your paper menu and AI creates a complete digital QR menu",
          "section1Title": "How the AI Menu Scanner Creates Your Digital QR Menu",
          "section1Text": "The process is simple: open IQ Rest, tap the scanner on the homepage, and take a photo of your paper menu. Our AI analyzes the image, recognizes dish names, descriptions, and prices, and automatically creates categories with all items. The scanner supports menus in any language and handles various formats — from simple printed menus to handwritten chalkboards. Within minutes, your complete digital QR menu is ready to customize and publish.",
          "section2Title": "AI-Generated Backgrounds for Your Restaurant Website",
          "section2Text": "Along with extracting menu items, the AI Scanner generates a professional background image for your restaurant website. Based on your restaurant type and cuisine, it creates a visually appealing hero image that sets the right atmosphere. Combined with AI image optimization that automatically enhances and compresses dish photos, your digital QR menu looks professional from day one — no graphic designer needed.",
          "section3Title": "From Paper Menu to Digital QR Menu in Minutes",
          "section3Text": "The AI Menu Scanner transforms the onboarding experience for new restaurants. Instead of manually typing every dish, simply photograph your existing menu. The scanner handles the tedious data entry while you focus on customizing colors, adding translations, and sharing your QR code. We also send helpful reminder emails to guide you through the process, ensuring every restaurant gets the most out of their digital QR menu.",
          "benefitsTitle": "Benefits of AI Menu Scanner for Restaurants",
          "benefit1": "Photograph any paper menu — AI extracts all dishes, prices, and descriptions automatically",
          "benefit2": "AI generates professional background images for your restaurant website",
          "benefit3": "Supports menus in any language with automatic recognition",
          "benefit4": "Complete digital QR menu ready in minutes instead of hours",
          "benefit5": "Free AI translation trials included — translate your menu into 10+ languages",
          "benefit6": "Smart onboarding flow guides you from photo to published QR menu",
          "conclusionTitle": "Create Your Digital QR Menu from a Photo Today",
          "conclusionText": "Stop typing your menu by hand. With IQ Rest's AI Menu Scanner, creating a digital QR menu for your restaurant has never been easier. Take a photo, let AI do the work, customize your design, and share your QR code with customers. Join hundreds of restaurants that have already gone digital with IQ Rest.",
          "ctaText": "Ready to create your digital QR menu from a photo?",
          "ctaButton": "Try AI Scanner Free"
        }
      },
      "redesigned-dashboard-qr-menu-management": {
        "title": "Redesigned Dashboard for Restaurant QR Menu Management",
        "description": "A completely rebuilt dashboard with faster page loads, server-side rendering, and modern navigation. Manage your restaurant's digital QR menu more efficiently than ever.",
        "meta": {
          "title": "New Dashboard for Restaurant QR Menu Management | IQ Rest",
          "description": "Completely redesigned restaurant dashboard with server-side rendering, instant page loads, and modern navigation. Manage your digital QR menu faster with the new IQ Rest control panel."
        },
        "content": {
          "intro": "IQ Rest has completely rebuilt the restaurant dashboard from the ground up. The new dashboard uses server-side rendering with Next.js file-based routing, delivering instant page loads and a smoother experience for managing your digital QR menu. Every page now loads with professional skeleton animations, and your menu data is prefetched on the server — so you see your categories, items, and settings immediately.",
          "image1Alt": "Redesigned restaurant QR menu dashboard",
          "image1Caption": "The new IQ Rest dashboard with faster navigation and modern design",
          "section1Title": "Server-Side Rendering for Instant QR Menu Management",
          "section1Text": "The previous dashboard loaded everything on the client side, causing delays. The new architecture prefetches your restaurant data on the server before the page even reaches your browser. Categories, menu items, tables, reservations, and analytics all load instantly. Each page has a dedicated loading skeleton so you never see a blank screen. This means managing your digital QR menu feels fast and responsive, even on slower connections.",
          "section2Title": "Modern Navigation and Unified Design",
          "section2Text": "The dashboard now features unified page headers with consistent styling across all sections. Sort modes for categories, items, and tables have been redesigned with an intuitive interface. The sidebar navigation is cleaner, with Languages merged into Settings and Design renamed to Appearance. A new checklist banner on the home page shows your setup progress, helping new restaurants complete their digital QR menu configuration quickly.",
          "section3Title": "Mobile-First QR Menu Management",
          "section3Text": "Every aspect of the new dashboard is optimized for mobile management. Sticky action buttons stay accessible as you scroll. Headers cast subtle shadows when scrolled to help with orientation. Browser back button navigation works reliably across all pages. Whether you're adding dishes between service or checking analytics on the go, managing your restaurant's digital QR menu from your phone is seamless.",
          "benefitsTitle": "Benefits of the New Dashboard",
          "benefit1": "Server-side data prefetching — menu loads instantly without waiting",
          "benefit2": "Professional loading skeletons on every page for smooth transitions",
          "benefit3": "Unified page headers and consistent design language throughout",
          "benefit4": "Improved sort modes for categories, items, and tables",
          "benefit5": "Checklist banner showing setup progress for new restaurants",
          "benefit6": "Browser back button works correctly across all dashboard pages",
          "conclusionTitle": "Experience the New Dashboard",
          "conclusionText": "The redesigned IQ Rest dashboard makes managing your restaurant's digital QR menu faster and more enjoyable. With server-side rendering, modern navigation, and mobile-first design, you can focus on what matters — creating a great menu for your customers. Log in now and experience the difference.",
          "ctaText": "Ready to try the new dashboard?",
          "ctaButton": "Open Dashboard"
        }
      },
      "multi-currency-geo-pricing-qr-menu": {
        "title": "Multi-Currency Pricing for Restaurant QR Menu Worldwide",
        "description": "IQ Rest now automatically detects your country and shows pricing in your local currency. Create a digital QR menu for your restaurant with pricing in EUR, USD, GBP, and more.",
        "meta": {
          "title": "Multi-Currency Pricing for Restaurant QR Menu Worldwide | IQ Rest",
          "description": "IQ Rest now supports multi-currency pricing based on your location. Create a digital QR menu with plans priced in EUR, USD, GBP, PLN, and more. Automatic geo-detection for restaurants worldwide."
        },
        "content": {
          "intro": "IQ Rest now supports multi-currency pricing for restaurants worldwide. When you visit the pricing page, your country is automatically detected via Cloudflare geo-location, and prices are displayed in your local currency. Whether you're in Europe, the Americas, or Asia — you'll see plan prices in a currency that makes sense for your business. Creating a digital QR menu for your restaurant is now truly accessible globally.",
          "image1Alt": "Multi-currency pricing for restaurant QR menu",
          "image1Caption": "Pricing automatically adapts to your local currency based on geo-detection",
          "section1Title": "Automatic Country and Currency Detection",
          "section1Text": "When you open IQ Rest, Cloudflare's global network identifies your country instantly. This information is used to select the most appropriate currency for your region — EUR for Europe, USD for the Americas, GBP for the UK, PLN for Poland, and many more. The system also detects your preferred language and redirects you to the localized version of the site. No manual currency switching needed — everything adapts automatically so you can focus on creating your digital QR menu.",
          "section2Title": "Local Pricing for Every Region",
          "section2Text": "Plans are priced competitively in each currency with region-appropriate pricing. The Free plan remains free everywhere — create a digital QR menu with up to 500 scans per month at no cost. Growth and Pro plans show clean, rounded prices in your local currency. Yearly plans offer significant savings with nice round monthly equivalents. All prices include the same features regardless of currency — there are no regional feature restrictions.",
          "section3Title": "Seamless Stripe Checkout in Local Currency",
          "section3Text": "The entire payment flow works in your local currency. From the pricing page through Stripe checkout to invoices and the customer portal — everything displays consistent pricing. Switching between monthly and yearly billing updates prices in real-time with a smooth carousel interface. Restaurants worldwide can now create their digital QR menu and pay in the currency they're most comfortable with.",
          "benefitsTitle": "Benefits of Multi-Currency Pricing",
          "benefit1": "Automatic country detection — no manual currency selection needed",
          "benefit2": "Localized pricing in EUR, USD, GBP, PLN, and more currencies",
          "benefit3": "Free plan available worldwide — create a QR menu at no cost",
          "benefit4": "Clean rounded prices optimized for each currency",
          "benefit5": "Automatic language detection based on your country",
          "benefit6": "Consistent currency throughout checkout and billing portal",
          "conclusionTitle": "Create Your Digital QR Menu in Your Currency",
          "conclusionText": "With multi-currency support, IQ Rest makes creating a digital QR menu accessible to restaurants worldwide. No matter where your restaurant is located, you'll see pricing that feels right for your market. Visit the pricing page now and see plans in your local currency.",
          "ctaText": "Ready to see pricing in your local currency?",
          "ctaButton": "View Pricing"
        }
      },
      "reservation-emails-analytics-digital-qr-menu": {
        "title": "Reservation Emails and Advanced Analytics for Digital QR Menu",
        "description": "Table reservation email notifications, welcome emails for new restaurants, device analytics, and scan usage tracking. Your digital QR menu is smarter than ever.",
        "meta": {
          "title": "Reservation Emails & Analytics for Digital QR Menu | IQ Rest",
          "description": "New features for your digital QR menu: table reservation email notifications to guests and owners, welcome emails, device and browser analytics, scan usage tracking, and free AI translation trials."
        },
        "content": {
          "intro": "IQ Rest continues to enhance the digital QR menu experience for restaurants with a wave of new features. Table reservations now send email confirmations to both guests and restaurant owners. New restaurants receive welcome emails with onboarding guidance. The analytics dashboard shows device, browser, and OS breakdowns. And scan usage tracking helps you monitor your digital QR menu's reach with clear visual indicators.",
          "image1Alt": "Reservation email notifications for restaurant digital QR menu",
          "image1Caption": "Email notifications keep guests and restaurant owners informed about reservations",
          "section1Title": "Table Reservation Email Notifications",
          "section1Text": "When a guest books a table through your restaurant's digital QR menu, both the guest and the restaurant owner now receive email notifications. The guest gets a confirmation with date, time, party size, and restaurant details. The owner receives an alert with the booking information so they can prepare. All emails are localized — sent in the language the guest used when making the reservation. This ensures a professional experience from the moment someone interacts with your digital QR menu.",
          "section2Title": "Welcome Emails and Onboarding Guidance",
          "section2Text": "New restaurants signing up for IQ Rest now receive a welcome email that guides them through setting up their digital QR menu. The email includes tips on adding categories, uploading dish photos, and sharing QR codes. For restaurants that haven't completed setup, smart reminder emails are sent with personalized guidance based on their onboarding progress. These emails recognize whether you already have menu items, categories, or background images, and suggest the next step.",
          "section3Title": "Device Analytics and Scan Usage Tracking",
          "section3Text": "The analytics dashboard now shows detailed breakdowns of device types, browsers, and operating systems used by your digital QR menu visitors. See whether customers scan your QR code on iPhone or Android, Chrome or Safari. A new scan usage indicator on the dashboard home page shows your monthly scans against your plan limit with a clear progress bar. Free plan restaurants get 500 scans per month, while Growth and Pro plans enjoy unlimited scans.",
          "benefitsTitle": "New Features for Your Digital QR Menu",
          "benefit1": "Email confirmations sent to both guests and restaurant owners for reservations",
          "benefit2": "Welcome emails guide new restaurants through digital QR menu setup",
          "benefit3": "Smart reminder emails based on onboarding progress",
          "benefit4": "Device, browser, and OS analytics for QR menu visitors",
          "benefit5": "Monthly scan usage indicator with plan limit tracking",
          "benefit6": "5 free AI translation trials for every restaurant",
          "conclusionTitle": "A Smarter Digital QR Menu for Your Restaurant",
          "conclusionText": "These updates make your digital QR menu more professional and insightful than ever. Email notifications keep everyone informed about reservations, analytics help you understand your customers, and usage tracking ensures you're getting the most from your plan. Log in to your dashboard and explore the new features.",
          "ctaText": "Ready to explore the new features?",
          "ctaButton": "Open Dashboard"
        }
      },
